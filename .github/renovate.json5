{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>philmichel/renovate-config'],
  packageRules: [
    // Merging only publishes the image -- nothing deploys from it. The PR
    // build (multi-arch, no push) is the only real check, so ignoreTests
    // must stay false.
    {
      description: 'Auto-merge base image digest rebuilds',
      matchDatasources: ['docker'],
      matchUpdateTypes: ['digest'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      description: 'Auto-merge base image version bumps after a short bake',
      matchDatasources: ['docker'],
      matchUpdateTypes: ['patch', 'minor', 'major'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: false,
      minimumReleaseAge: '1 day',
    },
  ],
}
